{
  "name": "orquestrador-agentes-app",
  "version": "0.2.2",
  "private": true,
  "description": "Central local de Orquestradores Claude: cada Orquestrador conversa com o usuário, divide o pedido em subtarefas e lança Subagentes em paralelo, com acompanhamento ao vivo pela tela.",
  "type": "commonjs",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/root.ts",
    "build": "tsc -p tsconfig.build.json && npm run web:build",
    "start": "node --env-file-if-exists=.env dist/root.js",
    "desktop": "electron .",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "npm run build",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:teste": "npm run build && electron-builder --win --publish never -c.extraMetadata.buildDeTeste=true -c.directories.output=dist_electron_teste",
    "release:win": "npm run build && electron-builder --win --publish always",
    "dist:mac": "node scripts/permissaoDoPty.cjs && npm run build && electron-builder --mac dir --arm64 --publish never -c.extraMetadata.repositorioDoMac=\"$PWD\" && codesign --force --deep --sign - \"dist_electron/mac-arm64/Orquestrador de Agentes.app\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "web:lint": "npm --prefix web run lint",
    "icones": "node scripts/gerarIcones.cjs",
    "postinstall": "node scripts/permissaoDoPty.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "electron-updater": "~6.3.9",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.30.0",
    "ws": "^8.22.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.orquestradoragentes.app",
    "productName": "Orquestrador de Agentes",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.js",
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.test.js.map",
      "!dist/**/*.test.d.ts",
      "!dist/**/fixtures/**",
      "web/dist/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/transformers.web*.js",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/node-pty/prebuilds/!(${platform})-*/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/!(${platform})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/${platform}/!(${arch})/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "electron/icones/icone.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "electron/icones/icone.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O ditado usa o microfone para transcrever o que você fala."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Le3Dev",
        "repo": "orquestrador-app",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "electron/icones/icone.ico",
      "uninstallerIcon": "electron/icones/icone.ico"
    }
  }
}
